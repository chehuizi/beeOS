# beeOS 全部环境变量样板
# 复制为 .env 后填入真实值
# 对应 [技术架构 §0 配置一览]

# === 部署元信息 ===
BEEOOS_INSTANCE_ID=dev
BEEOOS_ENV=development
BEEOOS_LOG_LEVEL=INFO

# === 数据库 ===
BEEOOS_POSTGRES_HOST=localhost
BEEOOS_POSTGRES_PORT=5432
BEEOOS_POSTGRES_DB=beeos
BEEOOS_POSTGRES_USER=beeos
BEEOOS_POSTGRES_PASSWORD=beeos-dev-password

# === Redis ===
BEEOOS_REDIS_HOST=localhost
BEEOOS_REDIS_PORT=6379
BEEOOS_REDIS_PASSWORD=
BEEOOS_REDIS_DB=0

# === Guardian (安全) ===
# 生产环境必须用 openssl rand -base64 32 生成
BEEOOS_MASTER_KEY=dev-only-do-not-use-in-prod-replace-me-32bytes
BEEOOS_API_TOKEN_SECRET=dev-only-secret-replace-me
BEEOOS_API_TOKEN_TTL_HOURS=24

# === LLM ===
# 变量名以 runtime/llm.py 实际读取的为准。下面这套 AB 切换
# （BEEOOS_LLM_PRIMARY_* / BEEOOS_LLM_FALLBACK_*）是早期设计稿里的，
# **代码里没有实现**，照着填不生效——别留着骗人了。
BEEOS_LLM_API_KEY=sk-your-key-here
BEEOS_LLM_BASE_URL=https://api.minimaxi.com/v1

# 为什么凭证放 .env 而不是 ~/.minimax/config.yaml：
# 那个文件是 MCode runtime 拥有的，它会重写——实测 apiKey 被改回
# sk-xxx 占位符、baseURL 退回内部代理 agent.minimax.cn。改一次丢一次。
# runtime 动不了进程环境变量，所以 .env 是稳的那一份。

# === 租户遥测 (默认关闭) ===
BEEOOS_VENDOR_TELEMETRY_ENABLED=false

# === Portal ===
# demo 阶段：直接填 IP 或 localhost（nginx 80 反代 + 静态 HTML）
BEEOOS_PORTAL_URL=http://localhost
BEEOOS_CORS_ALLOWED_ORIGINS=["http://localhost"]

# === Box 运行时 ===
BEEOOS_BOX_RUNTIME_DIR=/var/lib/beeos/boxes
BEEOOS_BOX_DEFAULT_TIMEOUT_SECONDS=1800
