# Queen / Bee / Boxes 共享基础镜像
# 多阶段构建：builder（dev deps）→ runtime（minimal）

FROM python:3.12-slim AS builder

# 安装 uv (与本地开发版本一致)
COPY --from=ghcr.io/astral-sh/uv:0.9.13 /uv /bin/uv

WORKDIR /app

# 阿里云 PyPI 镜像（国内 ECS 部署，避免官方源网络问题）
ENV UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    UV_HTTP_TIMEOUT=120 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 复制 workspace 配置
COPY pyproject.toml uv.lock* ./
COPY packages/beeos-core/pyproject.toml packages/beeos-core/
COPY apps/queen/pyproject.toml apps/queen/
COPY apps/bee/pyproject.toml apps/bee/
COPY apps/boxes/month-close/pyproject.toml apps/boxes/month-close/

# 复制源码（先复制再 sync，否则 install project 找不到 src）
COPY packages/beeos-core/src packages/beeos-core/src
COPY apps/queen/src apps/queen/src
COPY apps/bee/src apps/bee/src
COPY apps/boxes/month-close/src apps/boxes/month-close/src
COPY apps/boxes/month-close/box.yaml apps/boxes/month-close/

# 安装整个 workspace（包括所有项目 = 创建 queen 脚本入口）
RUN uv sync --frozen --all-packages

# === Runtime 镜像 ===
FROM python:3.12-slim AS runtime

WORKDIR /app

# 复制 uv 虚拟环境
COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# 健康检查默认指向 Queen
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:8080/health').raise_for_status()" || exit 1

EXPOSE 8080

# 默认启动 Queen；其他服务通过 docker-compose 覆盖 command
CMD ["queen"]
