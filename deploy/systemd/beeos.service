[Unit]
Description=beeOS - 私有化 AI 数字员工平台
Documentation=https://github.com/chehuizi/beeOS
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=deploy
WorkingDirectory=/opt/beeos
EnvironmentFile=/opt/beeos/.env

# 启动整个 docker-compose 栈
ExecStart=/usr/bin/docker compose -f /opt/beeos/docker-compose.yml up -d

# 停止
ExecStop=/usr/bin/docker compose -f /opt/beeos/docker-compose.yml down

# 重启：先 down 再 up（避免 stale container）
ExecReload=/usr/bin/docker compose -f /opt/beeos/docker-compose.yml restart

# 超时设置（启动可能拉镜像，给 5 分钟）
TimeoutStartSec=300
TimeoutStopSec=60

# 日志走 journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beeos

# 资源限制（避免 beeOS 拖垮 ECS）
MemoryMax=12G
TasksMax=200

# 自动重启
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
